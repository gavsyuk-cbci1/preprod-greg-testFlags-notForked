# Copy this file to `.env` and fill both values from step 2 of the FM onboarding wizard.
# `.env` is gitignored, so the key never lands in the repo.

# SDK key from the wizard's step 2 snippet. Required, the app shows an error without it.
VITE_SDK_KEY=

# Flag key from that same snippet. It has to match exactly, step 2 polls the platform for a flag
# with this key. Optional, defaults to `myFlag`.
VITE_FLAG_KEY=myFlag
